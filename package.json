{
  "name": "calibre-korea-isbn-metadata-plugin-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:python": "run-s python:compile python:test",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:workflow": "node rules/check-workflow.ts",
    "check:workflow-test": "node --test tests/check-workflow.test.ts",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "python:compile": "python3 -m compileall -q __init__.py tests",
    "python:test": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3",
    "pnpm": "^12.23.0"
  },
  "packageManager": "pnpm@12.23.0",
  "workflowChecks": {
    "actionDefaults": {
      "actions/checkout@v7": {
        "commit": "3d3c42e5aac5ba805825da76410c181273ba90b1",
        "defaults": {
          "allow-unsafe-pr-checkout": "false",
          "clean": "true",
          "fetch-depth": "1",
          "fetch-tags": "false",
          "lfs": "false",
          "persist-credentials": "true",
          "set-safe-directory": "true",
          "show-progress": "true",
          "sparse-checkout-cone-mode": "true",
          "ssh-strict": "true",
          "ssh-user": "git",
          "submodules": "false"
        }
      },
      "actions/setup-node@v7": {
        "commit": "949feb2413d6458794dcd2491c4babbbce0c15c1",
        "defaults": {
          "check-latest": "false"
        }
      },
      "actions/setup-python@v7": {
        "commit": "6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
        "defaults": {
          "allow-prereleases": "false",
          "check-latest": "false",
          "freethreaded": "false",
          "mirror": "https://raw.githubusercontent.com/actions/python-versions/main",
          "update-environment": "true"
        }
      },
      "pnpm/action-setup@v6": {
        "commit": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "defaults": {
          "cache": "false",
          "cache_dependency_path": "pnpm-lock.yaml",
          "package_json_file": "package.json",
          "run_install": "null",
          "standalone": "false"
        }
      }
    }
  }
}
