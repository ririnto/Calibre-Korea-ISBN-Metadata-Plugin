{
  "devDependencies": {
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.3",
    "npm-run-all2": "9.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "name": "calibre-korea-isbn-metadata-plugin-checks",
  "packageManager": "pnpm@12.11.2",
  "private": true,
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:python": "python3 -m py_compile __init__.py",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  }
}
