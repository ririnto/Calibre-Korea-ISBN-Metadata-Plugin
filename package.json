{
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "name": "calibre-korea-isbn-metadata-plugin-checks",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "scripts": {
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:python": "run-s python:compile python:test",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "python:compile": "python3 -m compileall -q __init__.py tests",
    "python:test": "python3 -m unittest discover -s tests -v"
  }
}
